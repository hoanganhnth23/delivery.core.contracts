<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.delivery</groupId>
    <artifactId>delivery-contracts-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>delivery-contracts-parent</name>

    <modules>
        <module>identity-contracts</module>
        <module>search-contracts</module>
        <module>routing-contracts</module>
        <module>delivery-contracts</module>
        <module>order-contracts</module>
    </modules>

    <build>
        <extensions>
            <extension>
                <groupId>com.google.cloud.artifactregistry</groupId>
                <artifactId>artifactregistry-maven-wagon</artifactId>
                <version>2.2.1</version>
            </extension>
        </extensions>
    </build>

    <repositories>
        <repository>
            <id>delivery-maven</id>
            <url>artifactregistry://asia-southeast1-maven.pkg.dev/lithe-paratext-506208-s5/delivery-maven</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <distributionManagement>
        <snapshotRepository>
            <id>delivery-maven</id>
            <url>artifactregistry://asia-southeast1-maven.pkg.dev/lithe-paratext-506208-s5/delivery-maven</url>
        </snapshotRepository>
        <repository>
            <id>delivery-maven</id>
            <url>artifactregistry://asia-southeast1-maven.pkg.dev/lithe-paratext-506208-s5/delivery-maven</url>
        </repository>
    </distributionManagement>
</project>
